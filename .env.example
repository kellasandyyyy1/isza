# Copy to .env.local and fill in. Never commit real values.
# Generate the VAPID pair with: npx web-push generate-vapid-keys
# VAPID_SUBJECT is mailto: plus your email, or your https:// site address.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
